# Testnet account that deploys everything. Keep this file local.
NEAR_ACCOUNT_ID=
NEAR_PUBLIC_KEY=
NEAR_PRIVATE_KEY=

# Build-time: compiled into room.wasm, so changing them changes its sha256.
# Use an attested model: anything else sends the secret outside a TEE.
DARKROOM_LLM_URL=https://cloud-api.near.ai/v1/chat/completions
DARKROOM_LLM_MODEL=z-ai/glm-5.3-flash
# Stored as an OutLayer author secret, never committed.
LLM_API_KEY=

# Written by scripts/deploy.sh into .darkroom.env, read by the CLI.
# DARKROOM_CONTRACT DARKROOM_TOKEN DARKROOM_PROJECT DARKROOM_WASM_HASH OUTLAYER_API

# Compiled into room.wasm: the room reads the escrow contract through this RPC.
DARKROOM_RPC_URL=https://test.rpc.fastnear.com/
DARKROOM_RPC_URL_2=https://near-testnet.drpc.org/
